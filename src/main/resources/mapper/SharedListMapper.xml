<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.packupbackend.mapper.SharedListMapper">

    <resultMap id="SharedListResultMap" type="com.example.packupbackend.entity.SharedList">
        <id property="id" column="id"/>
        <result property="shareCode" column="share_code"/>
        <result property="snapshotId" column="snapshot_id"/>
        <result property="ownerUserId" column="owner_user_id"/>
        <result property="recipientUserId" column="recipient_user_id"/>
        <result property="shareChannel" column="share_channel"/>
        <result property="permission" column="permission"/>
        <result property="expireTime" column="expire_time"/>
        <result property="sharedAt" column="shared_at"/>
        <result property="accessedAt" column="accessed_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.packupbackend.entity.SharedList" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO shared_list (share_code, snapshot_id, owner_user_id, recipient_user_id,
                               share_channel, permission, expire_time, shared_at, accessed_at)
        VALUES (#{shareCode}, #{snapshotId}, #{ownerUserId}, #{recipientUserId},
                #{shareChannel}, #{permission}, #{expireTime}, #{sharedAt}, #{accessedAt})
    </insert>

    <select id="selectById" parameterType="Long" resultMap="SharedListResultMap">
        SELECT * FROM shared_list WHERE id = #{id}
    </select>

    <select id="selectByShareCode" parameterType="String" resultMap="SharedListResultMap">
        SELECT * FROM shared_list WHERE share_code = #{shareCode}
    </select>

    <select id="selectByOwnerUserId" parameterType="Long" resultMap="SharedListResultMap">
        SELECT * FROM shared_list WHERE owner_user_id = #{ownerUserId}
    </select>

    <select id="selectByRecipientUserId" parameterType="Long" resultMap="SharedListResultMap">
        SELECT * FROM shared_list WHERE recipient_user_id = #{recipientUserId}
    </select>

    <select id="selectBySnapshotId" parameterType="Long" resultMap="SharedListResultMap">
        SELECT * FROM shared_list WHERE snapshot_id = #{snapshotId}
    </select>

    <select id="selectExpiredLists" resultMap="SharedListResultMap">
        SELECT * FROM shared_list WHERE expire_time &lt; #{currentTime}
    </select>

    <select id="selectAll" resultMap="SharedListResultMap">
        SELECT * FROM shared_list
    </select>

    <update id="update" parameterType="com.example.packupbackend.entity.SharedList">
        UPDATE shared_list
        SET share_code = #{shareCode}, snapshot_id = #{snapshotId}, owner_user_id = #{ownerUserId},
            recipient_user_id = #{recipientUserId}, share_channel = #{shareChannel},
            permission = #{permission}, expire_time = #{expireTime}, shared_at = #{sharedAt},
            accessed_at = #{accessedAt}
        WHERE id = #{id}
    </update>

    <update id="updateAccessedAt">
        UPDATE shared_list
        SET accessed_at = #{accessedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM shared_list WHERE id = #{id}
    </delete>

    <delete id="deleteByShareCode" parameterType="String">
        DELETE FROM shared_list WHERE share_code = #{shareCode}
    </delete>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM shared_list
    </select>

    <select id="countActiveByOwnerUserId" parameterType="Long" resultType="int">
        SELECT COUNT(*) FROM shared_list 
        WHERE owner_user_id = #{ownerUserId} 
        AND (expire_time IS NULL OR expire_time > NOW())
    </select>

</mapper>