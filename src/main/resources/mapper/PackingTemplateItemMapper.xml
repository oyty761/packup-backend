<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.packupbackend.mapper.PackingTemplateItemMapper">

    <resultMap id="PackingTemplateItemResultMap" type="com.example.packupbackend.entity.PackingTemplateItem">
        <id property="id" column="id"/>
        <result property="templateId" column="template_id"/>
        <result property="name" column="name"/>
        <result property="defaultQuantity" column="default_quantity"/>
        <result property="category" column="category"/>
        <result property="subCategory" column="sub_category"/>
        <result property="notes" column="notes"/>
        <result property="orderIndex" column="order_index"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.packupbackend.entity.PackingTemplateItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO packing_template_item (template_id, name, default_quantity, category, sub_category, notes, order_index)
        VALUES (#{templateId}, #{name}, #{defaultQuantity}, #{category}, #{subCategory}, #{notes}, #{orderIndex})
    </insert>

    <select id="selectById" parameterType="Long" resultMap="PackingTemplateItemResultMap">
        SELECT * FROM packing_template_item WHERE id = #{id}
    </select>

    <select id="selectByTemplateId" parameterType="Long" resultMap="PackingTemplateItemResultMap">
        SELECT * FROM packing_template_item WHERE template_id = #{templateId} ORDER BY order_index
    </select>

    <select id="selectAll" resultMap="PackingTemplateItemResultMap">
        SELECT * FROM packing_template_item
    </select>

    <update id="update" parameterType="com.example.packupbackend.entity.PackingTemplateItem">
        UPDATE packing_template_item
        SET template_id = #{templateId}, name = #{name}, default_quantity = #{defaultQuantity},
            category = #{category}, sub_category = #{subCategory}, notes = #{notes}, order_index = #{orderIndex}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM packing_template_item WHERE id = #{id}
    </delete>

    <delete id="deleteByTemplateId" parameterType="Long">
        DELETE FROM packing_template_item WHERE template_id = #{templateId}
    </delete>

    <select id="countByTemplateId" parameterType="Long" resultType="int">
        SELECT COUNT(*) FROM packing_template_item WHERE template_id = #{templateId}
    </select>

</mapper>